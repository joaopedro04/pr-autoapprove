# Copie para .env e ajuste. Variáveis de ambiente do sistema têm precedência sobre o .env.
# Listas aceitam valores separados por vírgula (a,b) ou array JSON (["a", "b"]).

# Modo
# live: posta review, resolve thread e aprova | dry-run: só loga o que faria | off: não faz nada
BOT_MODE=dry-run

# GitHub
# Org onde os PRs são buscados e conta do gh que comenta e aprova
GITHUB_ORG=my-org
GITHUB_LOGIN=my-login

# Quais PRs entram na fila
# Review pedido ao GITHUB_LOGIN direto ou a um destes times (slugs)
REVIEW_TEAMS=
# Repos cujo nome termina com um destes sufixos
REPO_SUFFIXES=-mfe,-frontend,-ui,-front,-container
# Repos que entram mesmo sem o sufixo, e repos que nunca entram
EXTRA_REPOS=
EXCLUDE_REPOS=
# Só PRs criados a partir desta data (AAAA-MM-DD)
ACTIVE_SINCE=2026-01-01

# Labels
# Aplicadas uma vez quando o PR entra na fila; as que não existem no repo são criadas.
# Lista simples (needs-qa,ci-autofix) ou array JSON com cor e descrição opcionais:
# PR_LABELS=[{"name": "ci-autofix", "color": "0E8A16", "description": "Loop de CI até verde"}, "needs-qa"]
PR_LABELS=

# Review
# Skill de code review (invocada como /<REVIEW_SKILL>) e o plugin que a fornece, como aparece em installed_plugins.json
REVIEW_SKILL=my-plugin:frontend-code-review
REVIEW_PLUGIN=my-plugin@my-marketplace
# Reviews do Claude rodando ao mesmo tempo, e o total de reviews por execução
REVIEW_CONCURRENCY=3
MAX_REVIEWS_PER_RUN=6
# Minutos que o head precisa ficar parado antes de revisar (junta uma sequência de pushes numa review só)
REVIEW_DEBOUNCE_MINUTES=5
# Falhas seguidas no mesmo PR até ele ir para ERROR e sair do fluxo
MAX_FAILURES=3

# Aprovação
# Minutos que o head precisa ficar parado antes de aprovar (dá tempo de o CI registrar os checks)
SETTLE_MINUTES=10
# true: PR sem nenhum check registrado não é aprovado
REQUIRE_CHECKS=true
# Checks que não seguram a aprovação, por repo: repo:Nome do check;outro-repo:Outro check
IGNORE_CHECKS=

# Claude
# Modelo fixo, para custo e qualidade não mudarem quando o padrão da conta mudar (vazio = padrão da conta)
CLAUDE_MODEL=claude-opus-5-5
# Tempo e gasto máximos de uma review
CLAUDE_TIMEOUT_MINUTES=30
CLAUDE_MAX_BUDGET_USD=20

# Agendador e painel (Windows, lidos pelo install_task.ps1)
# Intervalo e nome da tarefa do bot; o painel roda na tarefa <SCHEDULE_TASK_NAME>-dashboard
SCHEDULE_INTERVAL_MINUTES=5
SCHEDULE_TASK_NAME=pr-autoapprove
# Porta do painel ao vivo: http://127.0.0.1:<porta>/
DASHBOARD_PORT=8765

# Caminhos dos executáveis (no Windows, o caminho completo evita depender do PATH da tarefa)
GH_PATH=gh
CLAUDE_PATH=~/.local/bin/claude
# Opcional: pythonw.exe da tarefa (padrão: o do PATH, depois %LOCALAPPDATA%\Programs\Python\Python313)
PYTHONW_PATH=
