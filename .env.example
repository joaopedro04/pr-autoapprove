# Copie para .env e ajuste. Variáveis de ambiente do sistema têm precedência sobre o .env.

# live: posta review, resolve thread e aprova | dry-run: só loga o que faria | off: não faz nada
BOT_MODE=dry-run

# Conta do gh usada para comentar e aprovar, e a org onde os PRs são buscados
GITHUB_ORG=my-org
GITHUB_LOGIN=my-login

# Entram os PRs com review pedido ao GITHUB_LOGIN direto ou a um destes times (slugs, separados por vírgula)
REVIEW_TEAMS=
REPO_SUFFIXES=-mfe,-frontend,-ui,-front,-container
EXTRA_REPOS=
EXCLUDE_REPOS=
# Só PRs criados a partir desta data (AAAA-MM-DD)
ACTIVE_SINCE=2026-01-01

# Intervalo da tarefa do Agendador do Windows (lido pelo install_task.ps1)
SCHEDULE_INTERVAL_MINUTES=5
SCHEDULE_TASK_NAME=pr-autoapprove
# Porta do painel ao vivo (http://127.0.0.1:<porta>/), aberto pela tarefa <SCHEDULE_TASK_NAME>-dashboard no logon
DASHBOARD_PORT=8765
# Opcional: caminho do pythonw.exe (padrão: o do PATH, depois %LOCALAPPDATA%\Programs\Python\Python313)
PYTHONW_PATH=

# Reviews do Claude rodando ao mesmo tempo, e o total de reviews por execução
REVIEW_CONCURRENCY=3
MAX_REVIEWS_PER_RUN=6
MAX_FAILURES=3
# Minutos que o head precisa ficar parado antes de aprovar (dá tempo de o CI registrar os checks)
SETTLE_MINUTES=10
# Minutos que o head precisa ficar parado antes de revisar (junta uma sequência de pushes numa review só)
REVIEW_DEBOUNCE_MINUTES=5
REQUIRE_CHECKS=true
# repo:Nome do check;outro-repo:Outro check
IGNORE_CHECKS=

# Skill de code review (invocada como /<REVIEW_SKILL>) e o plugin que a fornece, como aparece em installed_plugins.json
REVIEW_SKILL=my-plugin:frontend-code-review
REVIEW_PLUGIN=my-plugin@my-marketplace

GH_PATH=gh
CLAUDE_PATH=~/.local/bin/claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT_MINUTES=30
CLAUDE_MAX_BUDGET_USD=20
